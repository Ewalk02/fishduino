#
# Waveshare ESP32-P4-WIFI6-7inch-Touch-LCD (B) — 1024x600 landscape
#

CONFIG_FISHDUINO_BOARD_7B=y
# CONFIG_FISHDUINO_BOARD_4IN is not set

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y

# Headless when LCD is not connected / for console-only bring-up
# CONFIG_FISHDUINO_HEADLESS is not set
