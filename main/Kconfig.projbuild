menu "Fishduino Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            Home Wi-Fi network name (2.4 GHz). Set via idf.py menuconfig.
            Saved in sdkconfig (gitignored).

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Wi-Fi password (WPA2/WPA3). Leave empty for open networks.

endmenu
