#
# Waveshare ESP32-P4-WIFI6 + 4-DSI-TOUCH-A (480x800 portrait)
#

CONFIG_FISHDUINO_BOARD_4IN=y
# CONFIG_FISHDUINO_BOARD_7B is not set

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_BSP_LCD_TYPE_480_800_4_INCH_A=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y

# Display enabled by default for the 4" panel target.
# CONFIG_FISHDUINO_HEADLESS is not set
